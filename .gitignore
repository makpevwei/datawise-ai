# --- Environment / secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- Uploaded / private data ---
# data/samples/ is intentionally NOT ignored -- those are example datasets
# used for local testing and are meant to be git-tracked.
data/uploads/*
!data/uploads/.gitkeep
data/documents/*
!data/documents/.gitkeep
data/reports/*
!data/reports/.gitkeep

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
*.sqlite3

# --- Node / Next.js (frontend) ---
node_modules/
.next/
out/
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/

# --- Build / dist ---
dist/
build/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Logs ---
*.log
