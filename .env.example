#######################################################
# DATAWISE AI — environment configuration
#
# Copy this file to .env (at this project root) and fill in real values.
# NEVER commit a real .env file. Every variable below is read by
# backend/app/config.py -- nothing here is aspirational or unused.
#######################################################

APP_NAME=DataWise AI
ENVIRONMENT=development

CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

#######################################################
# FILES / UPLOADS
#######################################################

# Both paths are relative to backend/ at runtime.
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_SIZE_MB=100

DOCUMENT_DIR=../data/documents
MAX_DOCUMENT_UPLOAD_MB=50

REPORTS_DIR=../data/reports

#######################################################
# DATABASE
#######################################################

# PostgreSQL (Neon or any standard Postgres). Required for authentication,
# dataset/document ownership and versioning, reports, and conversation
# history. Without it, the app cannot start user-scoped features.
DATABASE_URL=

#######################################################
# AUTHENTICATION
#######################################################

# Required for the app to issue/verify JWTs. Generate a long random
# string -- never reuse this example or commit a real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

#######################################################
# LLM PROVIDER
#######################################################

# Selects the primary provider: "openai", "anthropic", "gemini", "groq",
# or "openrouter". Without a configured provider, dataset upload,
# profiling, relationships, joins, KPIs, and Visual Insights all still
# work -- only "Ask DataWise" and document Q&A are disabled, with an
# honest "not configured" message rather than a fake response.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# Per-provider keys/models, used when LLM_PROVIDER selects that provider
# (or as automatic fallbacks if LLM_PROVIDER's primary call fails and
# these are also set).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DEFAULT_MODEL=

LLM_TIMEOUT=120
MAX_RETRIES=3
RETRY_BACKOFF=2
MAX_LLM_FALLBACKS=2
TEMPERATURE=0

AGENT_MAX_TOOL_ITERATIONS=8

#######################################################
# EMBEDDINGS / RAG
#######################################################

# "huggingface" (default) runs a free, local, CPU-only model -- no API key
# needed. "openai" is available if you'd rather use OpenAI embeddings.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RAG_MAX_RETRIEVAL_ITERATIONS=3
RAG_MAX_CHUNKS_PER_RETRIEVAL=8
RAG_CHUNK_SIZE_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=50

#######################################################
# WEB RESEARCH (optional -- none required)
#######################################################

# Priority when more than one is configured: Tavily, Exa, Firecrawl,
# SerpAPI, Google CSE.
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

SEARCH_TIMEOUT=60
MAX_RESEARCH_QUERIES=6
MAX_RESEARCH_SOURCES=30
MAX_RESEARCH_TOOL_CALLS=12

#######################################################
# EMAIL (optional -- report delivery only)
#######################################################

# Standard SMTP. Every other feature, including report generation and PDF
# export, works with none of these set -- only "Email Report" needs them,
# and it reports "not configured" honestly rather than pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
